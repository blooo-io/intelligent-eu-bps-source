{
  "name": "@intelligent/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "AC-01 reference web app — Refine portal (INT-137 / INT-115, TD-5)",
  "type": "module",
  "files": ["dist", "server-dist"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node server-dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@refinedev/core": "^5.0.12",
    "@refinedev/react-router": "^2.0.4",
    "antd": "^5.27.4",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
