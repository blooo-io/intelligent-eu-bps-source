{
  "realm": "demo",
  "enabled": true,
  "displayName": "INTELLIGENT demo",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "none",
  "smtpServer": {
    "host": "mailpit.int-apps.svc.cluster.local",
    "port": "1025",
    "from": "noreply@demo.intelligent-eu-bp.blooo.dev",
    "fromDisplayName": "Intelligent Billing & Payment (demo)",
    "replyTo": "noreply@demo.intelligent-eu-bp.blooo.dev",
    "replyToDisplayName": "Intelligent Billing & Payment (demo)",
    "envelopeFrom": "",
    "ssl": "false",
    "starttls": "false",
    "auth": "false",
    "user": "",
    "password": ""
  },
  "roles": {
    "realm": [
      {
        "name": "member",
        "description": "Billing community member"
      },
      {
        "name": "manager",
        "description": "Billing community manager"
      },
      {
        "name": "operator",
        "description": "Billing platform operator"
      },
      {
        "name": "service",
        "description": "Internal service principal"
      }
    ]
  },
  "clients": [
    {
      "clientId": "apisix-gateway",
      "name": "APISIX gateway (bearer JWT validation)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "dev-only-replace-me",
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "web",
      "name": "Refine web app (PKCE)",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://app.demo.intelligent-eu-bp.blooo.dev/*"
      ],
      "webOrigins": [
        "https://app.demo.intelligent-eu-bp.blooo.dev"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "community_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "community_id",
            "claim.name": "community_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "module-service",
      "name": "Inter-module service JWT (INT-287)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "dev-module-service-replace-me",
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-module-service",
      "enabled": true,
      "serviceAccountClientId": "module-service",
      "realmRoles": [
        "service"
      ]
    }
  ]
}
