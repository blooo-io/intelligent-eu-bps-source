{
  "name": "@intelligent/mocks",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "AC-15 V1 mock suite: market, data-space and FX ports with scenarios S1–S13 (INT-101)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
