{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelligent-project.eu/schema/v1.0.0/actor/actor",
  "title": "actor",
  "description": "EWDS topic: ontology Actor (Blooo). Project UI (R2M) publishes create and update (including CSV\u2192N Actors). BPS ActorSourcePort ingests only \u2014 no project-path CSV import. Address uses ontology field names (line1, not street). KYC-sensitive ontology fields (taxId, dateOfBirth, ownershipPercentage, nationality, isBeneficialOwner, isControlPerson) MUST NOT appear on the wire (ADR-013 \u2014 PSP-side only); they are omitted from this schema. DRAFT proposed by Blooo to EWAG (INT-447).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actorId",
    "name",
    "type",
    "communityId",
    "role",
    "isActive",
    "validFrom"
  ],
  "properties": {
    "actorId": {
      "type": "string",
      "format": "uuid",
      "description": "Primary identifier. IRI: int:actorId. UUID v4. REQ-058: participantId = actorId."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Legal name of the person or organisation. Ontology Actor.name."
    },
    "type": {
      "type": "string",
      "enum": [
        "NaturalPerson",
        "LegalEntity",
        "PublicBody",
        "Organisation"
      ],
      "description": "Ontology Actor.type."
    },
    "legalEntity": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "Legal entity name if different from name."
    },
    "communityId": {
      "type": "string",
      "format": "uuid",
      "description": "FK to the Community this actor belongs to."
    },
    "role": {
      "type": "string",
      "enum": [
        "Consumer",
        "Prosumer",
        "Producer",
        "Aggregator",
        "CommunityManager",
        "ProjectPartner",
        "Pilot"
      ],
      "description": "Ontology Actor.role (PascalCase enum)."
    },
    "isActive": {
      "type": "boolean",
      "description": "Whether the actor is active in the community."
    },
    "validFrom": {
      "type": "string",
      "format": "date-time",
      "description": "Inclusive start of validity."
    },
    "validUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "default": null,
      "description": "Exclusive end of validity; null = open-ended."
    },
    "residentialAddressId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "default": null,
      "description": "FK to Address.addressId used as residential address. Prefer id refs when Address is published separately; otherwise nest under residentialAddress."
    },
    "billingAddressId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "default": null,
      "description": "FK to Address.addressId used for billing."
    },
    "businessAddressId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "default": null,
      "description": "FK to Address.addressId used as business/registered address."
    },
    "contactDetailIds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true,
      "default": null,
      "description": "FKs to ContactDetails.contactDetailsId. Prefer id refs; otherwise nest under contacts."
    },
    "residentialAddress": {
      "$ref": "#/$defs/Address",
      "description": "Nested Address when id-ref topics are not used. Ontology field names (line1)."
    },
    "billingAddress": {
      "$ref": "#/$defs/Address"
    },
    "businessAddress": {
      "$ref": "#/$defs/Address"
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContactDetails"
      },
      "description": "Nested ContactDetails when id-ref topics are not used."
    }
  },
  "$defs": {
    "Address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "addressId",
        "actorId",
        "line1",
        "city",
        "postalCode",
        "country"
      ],
      "properties": {
        "addressId": {
          "type": "string",
          "format": "uuid"
        },
        "actorId": {
          "type": "string",
          "format": "uuid"
        },
        "line1": {
          "type": "string",
          "minLength": 1,
          "description": "First line of the street address (ontology line1; not street)."
        },
        "line2": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "postalCode": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2."
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "ContactDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contactDetailsId",
        "actorId",
        "contactType"
      ],
      "properties": {
        "contactDetailsId": {
          "type": "string",
          "format": "uuid"
        },
        "actorId": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email",
          "default": null
        },
        "phoneNumber": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\+[1-9]\\d{1,14}$",
          "default": null,
          "description": "Landline in E.164."
        },
        "mobileNumber": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\+[1-9]\\d{1,14}$",
          "default": null,
          "description": "Mobile in E.164."
        },
        "contactType": {
          "type": "string",
          "enum": [
            "Primary",
            "Business",
            "Emergency"
          ]
        }
      }
    }
  }
}
