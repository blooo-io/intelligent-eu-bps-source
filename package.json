{
  "name": "intelligent-eu-billing-and-payment",
  "private": true,
  "version": "1.2.3",
  "description": "INTELLIGENT (GA 101160678) — Billing & Payment Service (T5.6 / D5.5)",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "contracts:lint": "spectral lint --fail-severity=error \"contracts/openapi/**/*.yaml\" && redocly lint && for f in contracts/asyncapi/*.v1.yaml; do asyncapi validate \"$f\" || exit 1; done",
    "contracts:mock": "prism mock contracts/openapi/webhooks/payment-provider.v1.yaml",
    "contracts:ewds": "node scripts/validate-ewds-schemas.mjs",
    "docs:dev": "pnpm --filter @intelligent/site dev",
    "docs:build": "pnpm --filter @intelligent/site build"
  },
  "devDependencies": {
    "@asyncapi/cli": "^6.3.1",
    "@redocly/cli": "^2.82.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@stoplight/spectral-cli": "^6.17.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "7",
    "@playwright/test": "1.56.1"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "body-parser": ">=2.4.0",
      "multer": ">=2.5.0",
      "vitest": "4.1.12",
      "@vitest/coverage-v8": "4.1.12",
      "jsonpath-plus": ">=10.4.0",
      "simple-git": ">=4.0.1",
      "@simple-git/argv-parser": ">=2.0.1",
      "lodash": ">=4.18.0",
      "@faker-js/faker": ">=10.5.0",
      "fast-uri": ">=3.1.9",
      "qs": ">=6.16.1",
      "vite": "6.4.6",
      "@vitest/mocker": "4.1.12",
      "minimatch@>=7": ">=11.0.1",
      "glob@>=9": ">=14.0.2",
      "uuid@<11.1.1": ">=11.1.1",
      "ajv@<6.14.0": "6.14.0",
      "@babel/core": ">=7.29.6",
      "fast-xml-parser": ">=5.12.0"
    }
  }
}
