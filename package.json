{
  "name": "intelligent-eu-billing-and-payment",
  "private": true,
  "version": "1.0.0",
  "description": "INTELLIGENT (GA 101160678) — Billing & Payment Service (T5.6 / D5.5)",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "contracts:lint": "spectral lint --fail-severity=error \"contracts/openapi/**/*.yaml\" && redocly lint && for f in contracts/asyncapi/*.v1.yaml; do asyncapi validate \"$f\" || exit 1; done",
    "contracts:mock": "prism mock contracts/openapi/public.v1.yaml",
    "contracts:ewds": "node scripts/validate-ewds-schemas.mjs",
    "docs:dev": "pnpm --filter @intelligent/site dev",
    "docs:build": "pnpm --filter @intelligent/site build"
  },
  "devDependencies": {
    "@asyncapi/cli": "^6.2.1",
    "@redocly/cli": "^2.64.1",
    "@stoplight/prism-cli": "^5.14.2",
    "@stoplight/spectral-cli": "^6.15.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "7"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18"
    }
  }
}
