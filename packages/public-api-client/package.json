{
  "name": "@intelligent/public-api-client",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "TypeScript types for the public Billing API (INT-244 / TD-13 / REQ-052)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript -c ./openapi-ts.redocly.yaml",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
